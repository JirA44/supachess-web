rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function counterPath() {
      return /databases/$(database)/documents/site_stats/counters;
    }

    function markerPath(uid) {
      return /databases/$(database)/documents/registered_user_markers/$(uid);
    }

    function oldRegisteredCount() {
      return exists(counterPath())
        && ('registered_users' in get(counterPath()).data)
        ? get(counterPath()).data.registered_users
        : 0;
    }

    function validMarkerForCounter(uid) {
      return isOwner(uid)
        && !exists(markerPath(uid))
        && existsAfter(markerPath(uid))
        && getAfter(markerPath(uid)).data.uid == uid
        && getAfter(markerPath(uid)).data.registered_at == request.time
        && existsAfter(counterPath())
        && getAfter(counterPath()).data.registered_users is int
        && getAfter(counterPath()).data.registered_users == oldRegisteredCount() + 1;
    }

    function validCounterForMarker(uid) {
      return isOwner(uid)
        && existsAfter(counterPath())
        && getAfter(counterPath()).data.registered_users is int
        && getAfter(counterPath()).data.registered_users == oldRegisteredCount() + 1;
    }

    function validCounterCreate() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['registered_users'])
        && request.resource.data.registered_users == 1
        && validMarkerForCounter(request.auth.uid);
    }

    function validCounterUpdate() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered_users'])
        && request.resource.data.registered_users is int
        && request.resource.data.registered_users == oldRegisteredCount() + 1
        && validMarkerForCounter(request.auth.uid);
    }

    match /site_stats/counters {
      // This document contains aggregate totals only; callers cannot enumerate
      // the site_stats collection or write unrelated counters.
      allow get: if true;
      allow list, delete: if false;
      allow create: if validCounterCreate();
      allow update: if validCounterUpdate();
    }

    match /registered_user_markers/{uid} {
      // One private, immutable marker per account makes counting idempotent.
      allow get: if isOwner(uid);
      allow list, update, delete: if false;
      allow create: if validCounterForMarker(uid)
        && request.resource.data.keys().hasOnly(['uid', 'registered_at'])
        && request.resource.data.keys().hasAll(['uid', 'registered_at'])
        && request.resource.data.uid == uid
        && request.resource.data.registered_at == request.time
        && !exists(markerPath(uid));
    }

    match /presence/{uid} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'status', 'lastSeen', 'page'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'status', 'lastSeen'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.status in ['dispo', 'occupe', 'invisible', 'offline']
        && request.resource.data.lastSeen == request.time
        && (!('page' in request.resource.data)
          || (request.resource.data.page is string
            && request.resource.data.page.size() <= 200));
      allow delete: if isOwner(uid);
    }

    // Only sanitized, active-status records can be written here. The UI caps
    // its query to 100 records; this collection intentionally contains no PII.
    match /presence_public/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'status', 'lastSeen'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'status', 'lastSeen'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && !request.resource.data.displayName.matches('.*@.*')
        && request.resource.data.status in ['dispo', 'occupe']
        && request.resource.data.lastSeen == request.time;
      allow delete: if isOwner(uid);
    }

    // Prototype model: one owner-written puzzle score per account.
    // Only authenticated users can read pseudonymous scores; profile data is not exposed.
    function isValidPuzzleLeaderboardEntry() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'puzzleElo', 'puzzlesSolved', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'puzzleElo', 'puzzlesSolved', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && !request.resource.data.displayName.matches('.*@.*')
        && request.resource.data.puzzleElo is int
        && request.resource.data.puzzleElo >= 400
        && request.resource.data.puzzleElo <= 4000
        && request.resource.data.puzzlesSolved is int
        && request.resource.data.puzzlesSolved >= 0
        && request.resource.data.updatedAt == request.time;
    }

    match /puzzle_leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner(uid) && isValidPuzzleLeaderboardEntry();
      allow update: if isOwner(uid) && isValidPuzzleLeaderboardEntry();
      allow delete: if false;
    }

    // Detailed chess games are private to their owning Firebase account.
    match /users/{uid}/games/{gameId} {
      function validGameDocument() {
        return request.resource.data.keys().hasOnly([
            'schemaVersion', 'gameId', 'date', 'opponent', 'moves',
            'avgRating', 'history', 'pgn', 'result', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'gameId', 'date', 'opponent', 'moves',
            'avgRating', 'history', 'pgn', 'result', 'createdAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.gameId == gameId
          && request.resource.data.date is string
          && request.resource.data.date.size() <= 80
          && request.resource.data.opponent is string
          && request.resource.data.opponent.size() <= 160
          && request.resource.data.moves is int
          && request.resource.data.moves >= 0
          && request.resource.data.moves <= 1000
          && (request.resource.data.avgRating == null
            || request.resource.data.avgRating is int
            || request.resource.data.avgRating is float)
          && request.resource.data.history is list
          && request.resource.data.history.size() <= 600
          && request.resource.data.pgn is string
          && request.resource.data.pgn.size() <= 50000
          && request.resource.data.result is string
          && request.resource.data.result.size() <= 20
          && request.resource.data.createdAt == request.time;
      }
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) && validGameDocument();
      allow delete: if false;
    }

    // All other collections remain denied until their access patterns are
    // separately reviewed and given least-privilege rules.
  }
}
