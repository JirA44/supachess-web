{
  "name": "@supachess/engine",
  "version": "1.0.0",
  "description": "SupaChess chess engine - evaluation, search, and decision audit",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pst": {
      "import": "./dist/pst.js",
      "types": "./dist/pst.d.ts"
    },
    "./evaluate": {
      "import": "./dist/evaluate.js",
      "types": "./dist/evaluate.d.ts"
    },
    "./search": {
      "import": "./dist/search.js",
      "types": "./dist/search.d.ts"
    },
    "./audit": {
      "import": "./dist/audit.js",
      "types": "./dist/audit.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chess",
    "engine",
    "evaluation",
    "stockfish",
    "pst"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "terser": "^5.26.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "dependencies": {
    "chess.js": "^1.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
